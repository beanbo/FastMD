#pragma code_page(65001)
#include <winver.h>
#include "version.h"

1 ICON "fastmd.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FASTMD_VERSION_MAJOR,FASTMD_VERSION_MINOR,FASTMD_VERSION_PATCH,0
 PRODUCTVERSION FASTMD_VERSION_MAJOR,FASTMD_VERSION_MINOR,FASTMD_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FastMD"
            VALUE "FileDescription", "FastMD"
            VALUE "FileVersion", FASTMD_VERSION_STR
            VALUE "InternalName", "FastMD"
            VALUE "LegalCopyright", "© 2026 seka. GPL-3.0"
            VALUE "OriginalFilename", "FastMD.exe"
            VALUE "ProductName", "FastMD"
            VALUE "ProductVersion", FASTMD_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
